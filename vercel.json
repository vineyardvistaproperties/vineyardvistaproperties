{
  "rewrites": [
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/",
      "destination": "/api/protected?route=home"
    },
    {
      "source": "/guide",
      "destination": "/api/protected?route=guide"
    },
    {
      "source": "/management",
      "destination": "/api/protected?route=management"
    },
    {
      "source": "/management/rentals",
      "destination": "/api/protected?route=rentals"
    },
    {
      "source": "/management/house-standards",
      "destination": "/api/protected?route=house-standards"
    },
    {
      "source": "/management/property",
      "destination": "/api/protected?route=property"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/guide.html",
      "destination": "/guide",
      "permanent": false
    },
    {
      "source": "/management.html",
      "destination": "/management",
      "permanent": false
    },
    {
      "source": "/rentals.html",
      "destination": "/management/rentals",
      "permanent": false
    },
    {
      "source": "/house-standards.html",
      "destination": "/management/house-standards",
      "permanent": false
    },
    {
      "source": "/property-management.html",
      "destination": "/management/property",
      "permanent": false
    }
  ]
}